{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CAD Studio Codex Final Response",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "changedFiles", "verification", "risks", "nextSteps"],
  "properties": {
    "summary": {
      "type": "string",
      "description": "Görevin tamamlanma durumunu Türkçe özetleyin; İngilizce teknik terimleri koruyun."
    },
    "changedFiles": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Bu görevde değiştirilen veya oluşturulan önemli dosyaların yolları."
    },
    "verification": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "status", "note"],
        "properties": {
          "command": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["passed", "failed", "skipped"]
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "İnsan tarafından ele alınması gereken kalan riskler."
    },
    "nextSteps": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Önerilen sonraki eylem."
    }
  }
}
